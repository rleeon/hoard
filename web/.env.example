# Hoard Cloud web — public-only env. Anything prefixed with PUBLIC_
# is bundled into the client; never put service-role keys here.

# Supabase (anon key is safe to expose; service_role is NOT)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key

# Backend API (hoard-server with --features cloud)
PUBLIC_API_URL=https://api.hoard.services

# Hosted checkout URLs (Merchant of Record), one per plan/cycle.
PUBLIC_CHECKOUT_PRO_MONTHLY=https://checkout.example.com/pro-monthly
PUBLIC_CHECKOUT_PRO_YEARLY=https://checkout.example.com/pro-yearly
PUBLIC_BILLING_PORTAL=https://checkout.example.com/billing
