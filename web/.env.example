# Hoard Cloud web — public-only env. Anything prefixed with PUBLIC_
# is bundled into the client; never put service-role keys here.

# Supabase (anon key is safe to expose; service_role is NOT)
PUBLIC_SUPABASE_URL=https://zddepgqdiuhhzqdimsks.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key

# Backend API (hoard-server-cloud)
PUBLIC_API_URL=https://api.hoard.services

# Lemon Squeezy checkout links (one per plan/variant)
PUBLIC_LS_CHECKOUT_PRO_MONTHLY=https://hoard.lemonsqueezy.com/checkout/buy/REPLACE
PUBLIC_LS_CHECKOUT_PRO_YEARLY=https://hoard.lemonsqueezy.com/checkout/buy/REPLACE
PUBLIC_LS_CHECKOUT_PROPLUS_MONTHLY=https://hoard.lemonsqueezy.com/checkout/buy/REPLACE
PUBLIC_LS_CHECKOUT_PROPLUS_YEARLY=https://hoard.lemonsqueezy.com/checkout/buy/REPLACE
PUBLIC_LS_CUSTOMER_PORTAL=https://hoard.lemonsqueezy.com/billing
