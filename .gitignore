crates/hoard-desktop/gen/

# Frontend
crates/hoard-desktop/ui/node_modules/
crates/hoard-desktop/ui/dist/
crates/hoard-desktop/ui/.vite/

# Compiled sidecars (`hoard-screen-<triple>`, `hoardd-<triple>`,
# `hoard-<triple>`), which `scripts/build-sidecar.sh` leaves next to
# `tauri.conf.json` so the bundler flattens them beside the exe. The runtime
# resolver looks for them there, and the old `binaries/` subdirectory broke that
# resolution. The sources live in `crates/`.
crates/hoard-desktop/binaries/
crates/hoard-desktop/hoard-screen-*
crates/hoard-desktop/hoardd-*
crates/hoard-desktop/hoard-x86_64-*
crates/hoard-desktop/hoard-aarch64-*

# This project uses pnpm: npm and yarn lockfiles dropped here by accident are not
# tracked. `pnpm-lock.yaml` is the source of truth.
package-lock.json
yarn.lock

# Loose files left in the tree by accident.
*.zip

# ---- drafts at the root
# Root only, so CHANGELOG.md and the other main documents are unaffected.
/guide*.md
/version*.md
/plan*.md
/notes*.md
/draft*.md
/scratch*.md
/*.local.md
