# ---- everything private, in one place
# Working notes, ADRs, the security audit, legal, research. Index in
# `.local/README.md`. It never leaves the machine.
/.local/

# Context for AI sessions: one at the root and one per crate. No leading
# slash, so the file is ignored at any depth.
CLAUDE.md
.claude/

# Local git hooks (a mirror of CI).
/.githooks/

# Editor metadata (an Obsidian vault over the repo).
.obsidian/

# ---- secrets and per-machine config
.env
.env.local
.info
deploy/config.toml

# The Docker stack's config belongs to the user, not to the repo. Versioning it
# meant a `git pull` walked over their configuration, `data_dir` included, which
# is how a self-hoster lost track of their database in aug-2026. The guide already
# says `cp deploy/config.toml.example ...`.
deploy/docker/config/config.toml

# Discord status bot: local infra with secrets in it.
/deploy/.env.discord-bot
/deploy/scripts/discord-status-bot.py
/deploy/systemd/hoard-discord-bot.service

# Admin metrics panel (uses service_role).
/tools/admin-dashboard.html
/tools/serve-dashboard.sh

# ---- migrations with the user's uid baked in
# Applied by hand in production. `sqlx::migrate!` embeds the folder at compile
# time and aborts the boot with `VersionMissing` when the database holds a version
# the binary does not carry, which is why the cloud server is built from this tree
# (deploy/fly/Dockerfile), where they are on disk, and not from a clean clone.
# Since 2026-08-13 the migrator runs with `set_ignore_missing(true)`, so a build
# without them boots instead of sitting in a restart loop. Learning that cost a
# morning of service: a deploy from a worktree, `VersionMissing(30)`, and the API
# down until the rollback.
/crates/hoard-server/migrations/postgres/0030_admin_metrics.sql
/crates/hoard-server/migrations/postgres/0039_admin_metrics_v2.sql
/crates/hoard-server/migrations/postgres/0044_admin_metrics_screen.sql

# ---- out of the repo on purpose
# The engine's test bench: a development tool, never published and never packaged.
# It lives outside the workspace (`exclude` in the root Cargo.toml) so its absence
# does not break a clean clone.
/crates/hoard-pruebas/

# Save map: a parked prototype, flawed and out of 1.0. Kept locally to pick back
# up, not published.
crates/hoard-desktop/ui/src/routes/Map.svelte

# Internal per-crate and per-folder READMEs.
/crates/hoard-agent/tests/fixtures/README.md
/crates/hoard-manifest/data/README.md
/crates/hoard-screen/README.md
/deploy/docker/README.md

# Lists only the user writes.
/rleeon.md
/vista.md

