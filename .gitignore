/target
*.db
*.db-wal
*.db-shm
.env
.info
.env.local
deploy/config.toml
/dist
/dist-v1
/dist-*

# Local scratch / draft notes that should never be committed.
# Root-only patterns: docs/**.md and CHANGELOG.md are unaffected.
/guide*.md
/version*.md
/plan*.md
/notes*.md
/draft*.md
/scratch*.md

# Private context for Claude Code sessions. Workstation-specific,
# may reference local paths or tokens — never committed.
CLAUDE.md
.claude/

# Local editor metadata (Obsidian vault state over the repo).
.obsidian/

# Tauri build artifacts
crates/hoard-desktop/gen/

# Frontend build artifacts
crates/hoard-desktop/ui/node_modules/
crates/hoard-desktop/ui/dist/
crates/hoard-desktop/ui/.vite/

# Closed-source Pro UI, copied in from the private hoard-pro repo at build
# time. The public build resolves `$pro` to the inert pro-stub instead — Pro
# code must never land in this repo.
crates/hoard-desktop/ui/src/lib/pro/

# This project uses pnpm — npm/yarn lockfiles dropped in by accident
# (e.g. running `npm install` against the same package.json) shouldn't
# be tracked. pnpm-lock.yaml is the source of truth.
package-lock.json
yarn.lock

# Stray archives accidentally dropped in the tree (e.g. an exported
# `hoard-agent.zip`) — build/scratch artifacts, never source.
*.zip
