# Hoard Server Configuration
# Copy this file to /etc/hoard/config.toml and adjust values.
# Environment variable overrides use prefix HOARD__ with double underscores:
#   HOARD__SERVER__PORT=9000 overrides [server].port

[server]
# Listen address. Use 0.0.0.0 to bind on all interfaces.
host = "0.0.0.0"
# TCP port to listen on. 12421 is Hoard's default, a high, uncommon port so it
# won't clash with anything you're already running (and below the ephemeral
# range, so it's safe to bind). Change it only if you must.
port = 12421
# Public URL. The key is required by the config schema, but in self-hosted
# mode the value is never read, only Hoard Cloud deployments use it (for
# self-referencing links). Leave it as-is; no need to touch it.
public_url = "https://hoard.example.com"
# Allow admins to trigger a self-upgrade from the desktop app via
# POST /v1/admin/upgrade. The request only drops a marker file; a root
# systemd oneshot (hoard-upgrade.service) does the signed binary swap and
# restart (see ADR 0017). Set to false to disable the remote path entirely.
allow_remote_upgrade = true

# Whose X-Forwarded-For this server believes. Anyone who can reach the port can
# write that header, so it is only read when the connection itself comes from
# one of these; from anybody else the connection's own address is used.
#
# Leave it alone if the server is exposed directly, or if your reverse proxy
# runs on the same machine and connects over 127.0.0.1 (the default covers
# that). Add your proxy's address if it reaches the server from somewhere else
#, a container on a Docker network, another box on the LAN, or every client
# behind it counts as one for the panel's login throttle.
#
# Accepts addresses, CIDRs, and the shorthands "loopback", "private" (RFC 1918
# + CGNAT + IPv6 ULA) and "any" (believe everyone; only for a proxy whose
# address you cannot pin down). An empty list believes nobody.
trusted_proxies = ["loopback"]
# e.g. behind a proxy container on the default Docker bridge network:
# trusted_proxies = ["loopback", "172.16.0.0/12"]

# Per-IP request rate limiting (token bucket). This is an in-process safety
# net against accidental request loops and cheap brute force; a production
# deployment should ALSO rate-limit at the reverse proxy. Note this limiter
# still keys off X-Forwarded-For / X-Real-Ip / Forwarded regardless of
# `trusted_proxies` above, falling back to the connection peer, it is a guard
# against runaway clients, not against someone deliberately evading it. Omit
# this table to keep the defaults below.
[server.rate_limit]
# Master switch. Set to false to disable entirely.
enabled = true
# Sustained allowance per client IP: one request slot replenishes every
# 1/per_second seconds.
per_second = 20
# Burst capacity: requests allowed back-to-back before the sustained rate
# applies. Over the limit the server replies 429 Too Many Requests.
burst = 60

[storage]
# Directory where the SQLite DB, temp upload staging and (with the default
# local backend) all blob/chunk bytes are stored. Must be writable by the
# hoard user. The DB, tmp/ staging and the upgrade marker ALWAYS live here,
# even when blobs go to S3.
data_dir = "/var/lib/hoard"
# Maximum size of a single snapshot upload in megabytes.
#
# Two jobs: keeping a modded save with a few GB of files from being refused, and
# catching the case where someone points Hoard at a game's *install* directory
# instead of its saves, that mistake is common, and a cap is the only thing
# that stops it quietly filling the disk. Raise it if a legitimate save needs
# more; don't remove the idea of a limit.
#
# It is measured against the save's total size, and clients from 1.1.3 on are
# told the number up front instead of finding out mid-upload. It is also the
# ceiling on any single request body, but since 1.1.3 a save no longer travels
# in one request (each file that the server is missing is its own upload), so
# this stopped being the thing a big save collides with.
#
# NOTE: an existing install already has this written to its own config.toml.
# Changing it here only affects fresh ones.
max_snapshot_size_mb = 4096
# How long in seconds a client has to finish an upload.
upload_timeout_secs = 600
# Where blob/chunk bytes live: "local" (default, on disk under data_dir) or
# "s3" (any S3-compatible endpoint, see [storage.s3] below). Existing installs
# upgrade with zero changes: omit this and you stay on local disk.
# backend = "local"

# External S3-compatible object storage (MinIO, Backblaze B2, Cloudflare R2,
# Garage, Wasabi, or an `rclone serve s3` bridge in front of a consumer drive
#, OneDrive, Mega, Google Drive, Dropbox…; see SELF-HOST_GUIDE.md, that path
# has real trade-offs). Only read when backend = "s3". The server stays
# mandatory: it keeps the SQLite index, auth and deduplication, the bucket
# only holds opaque zstd blob/chunk bytes and is NOT restorable on its own
# without the server's database.
# [storage.s3]
# endpoint = "http://127.0.0.1:9000"        # MinIO example
# bucket = "hoard"
# region = ""                                # blank → "auto" (most ignore it)
# access_key_id = "minioadmin"
# secret_access_key = "minioadmin"
# key_prefix = ""                            # optional prefix on every object
# force_path_style = true                    # MinIO/Garage/rclone need true

[database]
# SQLite database URL. Use an absolute path.
url = "sqlite:///var/lib/hoard/hoard.db"
# Maximum number of SQLite connections in the pool.
max_connections = 10

[auth]
# Token lifetime in days. 0 means no expiry.
token_lifetime_days = 365
# Set to false after creating the admin account to prevent open registration.
allow_registration = true

# Web panel served from this same port at /panel: your saves, versions,
# machines and activity in a browser, plus a server section for admins.
# Signing in uses the password from `hoard-admin user create` (or a
# hoard_v1_ token). Setting enabled = false removes the panel pages AND the
# password login with them, leaving token-only API access.
[panel]
enabled = true
# How long a browser session lasts. Short on purpose: it is as powerful as a
# device token, and a browser is a shared, long-lived place.
session_days = 14
# Seconds the login door stays shut after five wrong passwords for the same
# account. Minimum 2, anything lower is read as 2, because with no pause at
# all each guess costs the server a full password hash and costs whoever is
# guessing a single request. Ten is short for a login form and right for a box
# on your own network: enough that the hashing can't be used as a CPU lever,
# little enough that fumbling your own password doesn't lock you out. Raise it
# towards a minute if you expose the panel to the open internet.
login_throttle_secs = 10

[retention]
# Days to keep soft-deleted snapshots in trash before permanent deletion.
trash_retention_days = 30
# Hours after which incomplete uploads in tmp/ are cleaned up.
tmp_cleanup_hours = 24
# Age-weighted snapshot pruning (ADR 0018). When true, the hourly cleanup
# thins redundant snapshots, keeping recent history dense and old history
# sparse. Pruned snapshots are soft-deleted into trash (recoverable, purged
# later by trash_retention_days). Pinned snapshots and the newest version
# are never pruned.
snapshot_pruning = true
# "Ahorro de datos" knob, 0.0..1.0. Higher keeps fewer snapshots. 0.3 is a
# light default; 1.0 keeps only the essentials, 0.0 keeps almost everything.
data_saving = 0.3

[logging]
# Log level: trace, debug, info, warn, error
level = "info"
# Log format: json (for journald/log aggregators) or pretty (for humans)
format = "json"
