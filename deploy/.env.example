# Hoard Cloud — example env vars for production.
# Copy to .env (or set in Fly secrets / CI) and never commit a real one.
# Figment merges these over config.toml using HOARD__SECTION__KEY=value.

# Listening
HOARD__SERVER__HOST=0.0.0.0
HOARD__SERVER__PORT=8082
HOARD__SERVER__PUBLIC_URL=https://api.hoard.services

# Database — Supabase Postgres
HOARD__DATABASE__BACKEND=postgres
HOARD__DATABASE__URL=postgres://postgres:<password>@db.<project>.supabase.co:5432/postgres
HOARD__DATABASE__MAX_CONNECTIONS=10

# Logging
HOARD__LOGGING__LEVEL=info
HOARD__LOGGING__FORMAT=json

# Supabase Auth (server-side verification only)
HOARD__CLOUD__SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
HOARD__CLOUD__SUPABASE_AUDIENCE=authenticated
HOARD__CLOUD__SUPABASE_ISSUER=https://<project>.supabase.co/auth/v1
HOARD__CLOUD__JWKS_REFRESH_SECS=3600
HOARD__CLOUD__UPGRADE_URL=https://hoard.services/upgrade

# Cloudflare R2
HOARD__CLOUD__R2__ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
HOARD__CLOUD__R2__BUCKET=hoard-snapshots-prod
HOARD__CLOUD__R2__REGION=auto
HOARD__CLOUD__R2__ACCESS_KEY_ID=<key>
HOARD__CLOUD__R2__SECRET_ACCESS_KEY=<secret>
HOARD__CLOUD__R2__PRESIGN_TTL_SECS=3600

# Lemon Squeezy
HOARD__CLOUD__LEMONSQUEEZY__API_KEY=<ls api key>
HOARD__CLOUD__LEMONSQUEEZY__WEBHOOK_SECRET=<ls webhook secret>
HOARD__CLOUD__LEMONSQUEEZY__STORE_ID=<store id>
# Variant IDs are configured in config.cloud.toml (env-nested arrays are
# clumsier than TOML for these). Set the IDs there and ship the file with
# the image; the secrets above stay out of the image.

# Optional — Sentry / Resend
# HOARD__SENTRY_DSN=https://...@sentry.io/...
# RESEND_API_KEY=<resend api key>
