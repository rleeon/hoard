# Hoard Cloud server config (Fly.io / cloud mode).
# Set `backend = "postgres"` to enable cloud mode (requires building with
# `--features cloud`). All secret-bearing fields can be supplied via env
# vars instead, prefer that in production. Figment merges
# `HOARD__SECTION__KEY=value` over this file.

[server]
host = "0.0.0.0"
port = 8082
public_url = "https://api.hoard.services"
# Per-IP rate limiting. Client IP is taken from X-Forwarded-For (Fly/CDN set
# it). Defaults shown; omit the table to use them. Still keep limits at the
# edge (Fly/Cloudflare), this is only an in-process backstop.
[server.rate_limit]
enabled = true
per_second = 20
burst = 60
# Per-device cap on the polling endpoints (sync/devices/notifications/
# heartbeat), requests per minute per (user, device, endpoint). 0 disables.
poll_per_minute = 10

[storage]
# Not used in cloud mode (snapshots live in R2), but the field is required
# by the config schema. Any writable path works.
data_dir = "/tmp/hoard"
max_snapshot_size_mb = 4096
upload_timeout_secs = 900

[database]
backend = "postgres"
# Set HOARD__DATABASE__URL=postgres://... in env in production.
url = "postgres://postgres:postgres@localhost:5432/hoard"
max_connections = 10

[auth]
# Self-hosted bearer-token settings, ignored in cloud mode but the config
# struct still parses them. Cloud uses Supabase JWTs.
token_lifetime_days = 365
allow_registration = false

[retention]
trash_retention_days = 30
tmp_cleanup_hours = 24
# Age-weighted snapshot pruning (ADR 0018). Note: in cloud mode the periodic
# cleanup task is self-hosted-only today; these keys are parsed but the prune
# pass runs on the disk-backed (sqlite) path. See plan storage-efficiency.md.
snapshot_pruning = true
data_saving = 0.3

[logging]
level = "info"
format = "json"

[cloud]
# Supabase JWKS URL, required.
# HOARD__CLOUD__SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
supabase_jwks_url = ""
supabase_audience = "authenticated"
supabase_issuer = ""
jwks_refresh_secs = 3600
upgrade_url = "https://hoard.services/upgrade"

[cloud.r2]
# Cloudflare R2: see https://developers.cloudflare.com/r2/api/s3/
# HOARD__CLOUD__R2__ENDPOINT=https://<account>.r2.cloudflarestorage.com
endpoint = ""
bucket = "hoard-snapshots-prod"
region = "auto"
access_key_id = ""
secret_access_key = ""
presign_ttl_secs = 3600

[cloud.lemonsqueezy]
api_key = ""
webhook_secret = ""
store_id = ""

# One entry per LS product. The store uses two separate products (Pro
# Monthly + Pro Yearly), each with its own product_id. The webhook
# handler matches by product_id; order doesn't matter.
[[cloud.lemonsqueezy.products]]
product_id = "1087714"
plan = "pro"
interval = "month"

[[cloud.lemonsqueezy.products]]
product_id = "1087715"
plan = "pro"
interval = "year"

# Polar (Merchant of Record). access_token + webhook_secret come from env
# (HOARD__CLOUD__POLAR__ACCESS_TOKEN / __WEBHOOK_SECRET); product UUIDs go
# here. The handler at POST /v1/webhooks/polar matches by product_id.
#
# Storage tiers: Pro sells in +25 GB steps (Pro x1 = 25 GB, x2 = 50, …).
# Each step is its OWN Polar product per interval; `storage_gb` tells the
# server how much that product grants (written to profiles.storage_limit_bytes
# by the webhook). One entry per (tier, interval). Add x3/x4/… by creating the
# products in Polar and appending entries here. Omitting `storage_gb` means the
# plan default (100 GB), which is what the base Pro products do.
#
# IMPORTANT: replace the placeholder UUIDs with the real product IDs from your
# Polar dashboard. Downgrades must be issued with proration_behavior=next_period
# so the limit only shrinks at the period boundary.
# Grace window (days) a user keeps their old, larger storage limit after
# downgrading to a tier below their current usage. Nothing is purged during the
# window and /v1/me advertises the pending change so the app can warn first.
# Cloud-only; self-hosted has no quotas. 30 = one month of buffer after the
# paid period ENDS (subscription.revoked / retroactive expiry), never from the
# cancel click, the webhook only downgrades to Free on 'expired', not on the
# 'grace' state a cancellation leaves behind.
storage_downgrade_grace_days = 30

[cloud.polar]
access_token = ""
webhook_secret = ""

# --- Pro (base), no `storage_gb` → falls to the 100 GB plan default ---
[[cloud.polar.products]]
product_id = "4404a328-9289-4077-b25b-162ecd1d6ed3"
plan = "pro"
interval = "month"

# The `interval` here is OUR label; the actual billing period lives on the
# Polar product and Polar will not let you change it after creation. The first
# yearly product (77d81015-7c9d-4009-b2a6-e0c0a0901899) was created with
# recurring_interval=month, so "Pro anual" billed €19.99 EVERY MONTH while
# /pricing advertised two months free. Nobody bought it; it's replaced below
# and archived in Polar. When you add a product, check its recurring_interval
# in the API, the product *name* proves nothing.
[[cloud.polar.products]]
product_id = "ee6d9395-cc3a-4b0c-96a5-4a008292ffc6"
plan = "pro"
interval = "year"

# --- Pro x2 (50 GB) ---
# [[cloud.polar.products]]
# product_id = "<polar-uuid-pro-x2-month>"
# plan = "pro"
# interval = "month"
# storage_gb = 50
#
# [[cloud.polar.products]]
# product_id = "<polar-uuid-pro-x2-year>"
# plan = "pro"
# interval = "year"
# storage_gb = 50

# --- Pro x3 (75 GB), x4 (100 GB), x5 (125 GB), x6 (150 GB) … same shape ---
